{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "skipLibCheck": true, "types": ["node"], "noEmit": true,
    "allowImportingTsExtensions": true, "isolatedModules": true
  },
  "include": ["src", "test", "api", "scripts", "vite.config.ts"]
}
